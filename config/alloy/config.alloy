// ============================================================================
// Grafana Alloy - LangChain Observability Collector
//
// 트레이스/메트릭은 앱의 OTLP(4317 gRPC / 4318 HTTP)로 들어옵니다.
//   OTLP 수신
//     ├─ traces  → Tempo  (otelcol.exporter.otlp)
//     │            + span → RED 메트릭 자동 생성 (otelcol.connector.spanmetrics)
//     └─ metrics → Prometheus (prometheus.remote_write)
//
// 로그는 OTLP를 쓰지 않습니다. 원칙: "stdout으로 출력되는 것(= docker logs 내용)
// 그대로 Loki로 수집한다". Alloy는 Docker API로 컨테이너 stdout을 읽습니다
// (loki.source.docker, 아래 §6). 쿠버네티스에 배포하면 이 컴포넌트만
// loki.source.kubernetes로 교체하면 kubectl logs 내용이 그대로 Loki로 들어옵니다.
//
// 각 컴포넌트의 output 블록으로 데이터 흐름을 연결합니다.
// ============================================================================

// ---------------------------------------------------------------------------
// 1. OTLP Receiver - 앱의 단일 수신점
// ---------------------------------------------------------------------------
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces  = [otelcol.processor.batch.traces.input]
    metrics = [otelcol.processor.batch.metrics.input]
  }
}

// ---------------------------------------------------------------------------
// 2. Batch Processor - 네트워크 효율을 위해 묶어서 전송
// ---------------------------------------------------------------------------
otelcol.processor.batch "traces" {
  timeout        = "2s"
  send_batch_size = 128

  output {
    traces = [
      otelcol.exporter.otlp.tempo.input,          // 트레이스 저장
      otelcol.connector.spanmetrics.default.input, // 트레이스로 RED 메트릭 생성
    ]
  }
}

otelcol.processor.batch "metrics" {
  timeout        = "2s"
  send_batch_size = 128

  output {
    metrics = [otelcol.exporter.prometheus.default.input]
  }
}

// ---------------------------------------------------------------------------
// 3. Traces → Tempo
// ---------------------------------------------------------------------------
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// ---------------------------------------------------------------------------
// 4. Traces → R.E.D 메트릭 자동 생성 (spanmetrics connector)
//    기본 차원: service.name, span.name, span.kind, status.code
//    여기에 LangChain 관련 차원(gen_ai.*)을 추가
// ---------------------------------------------------------------------------
otelcol.connector.spanmetrics "default" {
  namespace = "langchain" // 생성 메트릭 접두사 → langchain_calls, langchain_latency
  metrics_flush_interval = "10s" // 기본 60s. 학습용으로 대시보드 반영 주기 단축
  histogram {
    unit = "ms"
    explicit {
      buckets = ["10ms", "25ms", "50ms", "100ms", "250ms", "500ms", "1s", "2.5s", "5s", "10s"]
    }
  }
  dimension {
    name    = "gen_ai.operation.name"
    default = "unknown"
  }
  dimension {
    name    = "gen_ai.request.model"
    default = "unknown"
  }

  output {
    metrics = [otelcol.exporter.prometheus.default.input]
  }
}

// ---------------------------------------------------------------------------
// 5. OTLP Metrics & spanmetrics → Prometheus remote write
// ---------------------------------------------------------------------------
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.prom.receiver]
}

prometheus.remote_write "prom" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// ---------------------------------------------------------------------------
// 6. Logs → Loki (컨테이너 stdout 수집)
//    loki.source.docker = docker logs 와 똑같은 내용을 Docker API로 읽어 Loki로 전송.
//    쿠버네티스 배포 시 이 컴포넌트를 loki.source.kubernetes로 교체하면
//    kubectl logs 내용이 동일하게 Loki로 들어옵니다 (파이프라인/라벨 로직은 그대로).
//    컨테이너명이 obs-* 이므로 service_name 라벨을 obs- 접두사 제거로 만든다
//    (예: obs-ai-service → service_name="ai-service" — 기존 대시보드 쿼리 유지).
// ---------------------------------------------------------------------------
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  // 30초마다 신규/종료 컨테이너 재탐색 (앱 프로파일이 나중에 떠도 잡힘)
  refresh_interval = "30s"
}

// loki.source.docker는 엔트리에서 __meta_* 라벨을 제거하므로, 여기서 라벨을 만들어야 한다.
// 방법: discovery.docker → discovery.relabel 체인으로 target 라벨에 service_name 등을 추가하고
// 그 target들을 loki.source.docker에 전달 (K8s도 동일 패턴: discovery.kubernetes → relabel).
discovery.relabel "docker_labels" {
  targets = discovery.docker.containers.targets
  // 컨테이너명 obs-ai-service → service_name="ai-service" (대시보드 쿼리 라벨)
  // RE2에는 비캡처 그룹이 없으므로 슬래시는 /? 로, obs- 프리픽스는 캡처 밖으로
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "^/?obs-(.+)$"
    target_label  = "service_name"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "^/?(.+)$"
    target_label  = "container_name"
  }
  rule {
    source_labels = ["__meta_docker_container_id"]
    regex         = "(.+)"
    target_label  = "container_id"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_labels.output
  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ---------------------------------------------------------------------------
// 7. Alloy 자체 메트릭을 Prometheus로 scrape (인프라 상태 모니터링용)
// ---------------------------------------------------------------------------
prometheus.scrape "alloy_self" {
  targets         = [{"__address__" = "localhost:12345"}]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.prom.receiver]
}